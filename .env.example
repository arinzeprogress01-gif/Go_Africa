NODE_ENV=development
PORT=8080
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Database can be added now or later. If empty, the API runs in temporary
# in-memory mode for OTP and user records. Data is lost when the server restarts.
MONGODB_URI=

# Termii SMS credentials (get these from your Termii dashboard)
TERMII_API_KEY=
TERMII_SENDER_ID=GreenGig
TERMII_CHANNEL=generic
TERMII_BASE_URL=https://v3.api.termii.com

OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DEV_RETURN_CODE=false
